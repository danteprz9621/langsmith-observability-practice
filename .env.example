# LangSmith tracing + evaluate()/experiments -- free tier is enough for this project.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=trailhead-travel-observability

# Unused/vestigial at this point -- rag_agent.py ended up tracing the
# existing Ollama/Groq call directly with @traceable rather than routing
# through Anthropic's wrap_anthropic. Kept as a placeholder in case that
# changes later.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Leave unset for local dev (uses Ollama, free/local, as before). Set this
# to switch agents/rag_agent.py + experiments.py's judge onto Groq's hosted
# inference instead -- this is what CI uses (as a GitHub Actions secret,
# not from this file), since a CPU-only runner can't run 7-8B models fast.
# console.groq.com, no credit card needed for the free tier.
GROQ_API_KEY=your-groq-api-key-here

# Only read by experiments.py -- caps evaluate() to the first N golden
# examples instead of the full dataset. CI sets this (via the workflow,
# not this file) to keep request counts inside Groq's free-tier rate
# limits. Leave unset locally to evaluate the whole dataset.
EVAL_SAMPLE_SIZE=3
